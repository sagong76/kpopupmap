---
import { ADSENSE } from '../config';
interface Props { slot: keyof typeof ADSENSE.slots; label: string; class?: string }
const { slot, label, class: cls } = Astro.props;
const id = ADSENSE.slots[slot];
---
{ADSENSE.client && id && (
  <aside class:list={['ad', cls]} aria-label={label}>
    <span class="ad-label">{label}</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE.client} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
