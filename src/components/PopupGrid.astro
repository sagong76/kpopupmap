---
import { CATEGORIES, REGIONS, type Lang } from '../config';
import { T } from '../i18n';
import type { Popup } from '../lib/data';
import { shortDate } from '../lib/listing';
interface Props { lang: Lang; list: Popup[] }
const { lang, list } = Astro.props;
const t = T[lang];
---
<ul class="grid">
  {list.map((p) => {
    const c = CATEGORIES.find((x) => x.key === p.category)!;
    const r = REGIONS.find((x) => x.key === p.region);
    return (
      <li>
        <a class="gcard" href={`/${lang}/popup/${p.id}/`}>
          <div class="gimg" style={`background:${c.color}1f`}>
            {p.image ? <img src={p.image} alt={p.name[lang]} loading="lazy" decoding="async" width="300" height="375" /> : <span>{c.icon}</span>}
            {p.sponsored && <span class="badge sp gsp">★ {t.sponsored}</span>}
          </div>
          <div class="gbody">
            <div class="badges">
              <span class="badge" data-st data-a={p.start} data-b={p.end}></span>
              {p.foreigner === 'yes' && <span class="badge fx">🌏</span>}
              {p.reservation === 'required' && <span class="badge resv">{t.resv.required}</span>}
            </div>
            <h3 class="gname">{p.name[lang]}</h3>
            <div class="gmeta">📍 {r ? r[lang] : p.region}</div>
            <div class="gmeta">{shortDate(p.start)}{p.end !== p.start && ` - ${shortDate(p.end)}`}</div>
            <span class="cat">{c[lang]}</span>
          </div>
        </a>
      </li>
    );
  })}
</ul>
