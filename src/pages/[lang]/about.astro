---
import Base from '../../layouts/Base.astro';
import { LANGS, SITE, CONTACT_EMAIL, type Lang } from '../../config';
import { T } from '../../i18n';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const c = {
  ko: {
    h1: 'K-Popup Map 소개',
    p: [
      'K-Popup Map은 서울 성수동의 팝업스토어를 날짜와 카테고리별로 지도에서 찾을 수 있는 서비스입니다.',
      '매일 새로 열리고 닫히는 팝업 정보를 모아 기간, 위치, 운영시간, 인스타그램, 예약 방법을 한곳에 정리합니다. 특히 한국 예약 앱을 쓰기 어려운 해외 방문객을 위해 팝업마다 외국인 예약 가능 여부를 표시합니다.',
      '한국어·일본어·영어로 제공하며, 앞으로 홍대·종로 등 다른 지역으로 넓혀 갈 예정입니다.',
      '팝업 정보는 브랜드 공식 채널 등 공개된 자료를 바탕으로 정리하며, 일정은 브랜드 사정에 따라 바뀔 수 있습니다. 틀린 정보나 새 팝업 소식은 의견 보내기 페이지로 알려주세요. 브랜드 등록·광고 문의도 받습니다.',
    ],
  },
  ja: {
    h1: 'K-Popup Mapについて',
    p: [
      'K-Popup Mapは、ソウル・聖水洞のポップアップストアを日付とカテゴリ別に地図で探せるサービスです。',
      '毎日オープン・終了するポップアップの情報を集め、期間、場所、営業時間、Instagram、予約方法をひとつにまとめています。韓国の予約アプリを使いにくい海外からの旅行者のために、外国人予約の可否も表示しています。',
      '韓国語・日本語・英語に対応し、今後は弘大・鍾路など他のエリアにも拡大予定です。',
      '情報はブランドの公式チャンネルなど公開情報をもとに整理しており、日程は変更される場合があります。誤りや新しいポップアップ情報は「ご意見」ページからお知らせください。',
    ],
  },
  en: {
    h1: 'About K-Popup Map',
    p: [
      'K-Popup Map helps you find pop-up stores in Seongsu-dong, Seoul on a map, by date and category.',
      'We track pop-ups as they open and close and gather dates, location, hours, Instagram and booking info in one place. For visitors from abroad who can\'t easily use Korean booking apps, every listing shows whether foreigners can reserve.',
      'Available in Korean, Japanese and English, with Hongdae, Jongno and more areas coming next.',
      'Information is compiled from public sources such as official brand channels, and schedules may change. Spotted an error or a new pop-up? Let us know via the Feedback page — brand listings and advertising inquiries are welcome too.',
    ],
  },
}[lang];
---
<Base lang={lang} title={`${c.h1} | ${SITE.name}`} desc={c.p[0]} path="/about/">
  <main class="page"><div class="wrap">
    <article class="card prose">
      <h1 class="title">📍 {c.h1}</h1>
      {c.p.map((x) => <p>{x}</p>)}
      <p><a class="btn pri" href={`/${lang}/`}>🗺️ {SITE.name}</a> <a class="btn" href={`/${lang}/feedback/`}>💬 {T[lang].feedback}</a></p>
      {CONTACT_EMAIL && <p>✉️ {CONTACT_EMAIL}</p>}
    </article>
  </div></main>
</Base>
