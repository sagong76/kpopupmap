---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Affiliates from '../../../components/Affiliates.astro';
import { LANGS, SITE, type Lang } from '../../../config';
import { T } from '../../../i18n';
import { getGuides } from '../../../lib/guides';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => getGuides(lang).map((g) => ({ params: { lang, slug: g.slug }, props: { g } })));
}
const lang = Astro.params.lang as Lang;
const { g } = Astro.props as { g: ReturnType<typeof getGuides>[number] };
const t = T[lang];
const others = getGuides(lang).filter((x) => x.slug !== g.slug);
// 같은 파일 이름의 글이 있는 언어만 서로 연결 (없는 언어는 그 언어의 가이드 목록으로)
const langPaths = Object.fromEntries(
  LANGS.filter((l) => getGuides(l).some((x) => x.slug === g.slug)).map((l) => [l, `/guide/${g.slug}/`]),
);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: g.title, description: g.desc,
  inLanguage: lang, url: `${SITE.url}/${lang}/guide/${g.slug}/`, publisher: { '@type': 'Organization', name: SITE.name },
};
---
<Base lang={lang} title={`${g.title} | K-Popup Map`} desc={g.desc} path={`/guide/${g.slug}/`} jsonLd={jsonLd} langPaths={langPaths} fallbackPath="/guide/">
  <main class="page"><div class="wrap">
    <p class="crumb"><a href={`/${lang}/guide/`}>← {t.guideTitle}</a></p>
    <article class="card prose">
      <h1 class="title">{g.icon} {g.title}</h1>
      <g.Content />
    </article>
    <AdSlot slot="guide" label={t.ad} />
    <Affiliates lang={lang} />
    <div class="card">
      <a class="btn pri" href={`/${lang}/`} style="width:100%">🗺️ {t.tagline} →</a>
    </div>
    <ul class="glist">
      {others.map((o) => <li class="card"><a href={`/${lang}/guide/${o.slug}/`}><span class="gi">{o.icon}</span><span><b>{o.title}</b><p>{o.desc}</p></span></a></li>)}
    </ul>
  </div></main>
</Base>
