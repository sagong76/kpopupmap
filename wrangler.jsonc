// Cloudflare Workers(정적 자산) 배포 설정 — 빌드 결과물 dist/ 를 그대로 서비스합니다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpopupmap",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
